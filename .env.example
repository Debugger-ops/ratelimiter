# Redis holding the limiter state. Every app instance must point at the same one.
REDIS_URL=redis://default:DJRHUEmlJgaAFSmjtrVyPRZiuEqgvuAW@redis.railway.internal:6379
# IP family used to resolve REDIS_URL's host. 0 asks for both A and AAAA and
# takes whichever answers, which is what managed Redis on Railway/Fly needs —
# their private networks are IPv6-only and Node defaults to an IPv4 lookup.
# Set to 4 only if you point at an IPv4-only Redis whose DNS also answers AAAA.
REDIS_FAMILY=0

PORT=8080

# Required in anything but local dev — /admin can change every client's limits.
ADMIN_TOKEN=

# How often buffered metric counts are pipelined to Redis. Lower = fresher
# dashboard, more Redis traffic. At most this many ms of counts is lost if the
# process is killed.
METRICS_FLUSH_MS=250

# Number of proxies in front of this service. 0 means req.ip is the socket
# address. Set this to the real hop count behind a load balancer — leaving it
# at a wrong value lets a client forge X-Forwarded-For and mint a new identity
# per request, which defeats IP-based limiting entirely.
TRUST_PROXY_HOPS=0

# Local token leases. When on, an instance withdraws a block of a client's
# quota from Redis and spends it in process, so most decisions cost no round
# trip at all. This does not change the limit — the ceiling is enforced by the
# same atomic withdrawal — but it does change two observable things, which is
# why it is opt-in: RateLimit-Remaining becomes a lower bound rather than an
# exact figure, and a client's unspent quota can sit on an idle instance for up
# to LEASE_TTL_MS. See src/core/lease.ts.
LEASE_ENABLED=0

# How long an instance may hold unspent tokens before the reaper returns them.
# This is the knob that bounds how stale a client's quota can get: shorter is
# fairer, longer saves more round trips.
LEASE_TTL_MS=1000
